DATABASE_URL=postgresql+psycopg://enpageo:enpageo_dev@localhost:5434/enpageo
CORS_ORIGINS=http://localhost:3000

# Chat / language model (Ollama). CHAT_MODELS: models /api/chat may be asked for (benchmark), comma-separated;
# empty = only OLLAMA_MODEL. The API is public, so keep this to the models meant for the benchmark.
CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:30b
CHAT_MODELS=qwen3:30b,mistral-small3.2:24b,gpt-oss:20b,qwen3:8b,granite3.3:8b,qwen2.5:7b,qwen2.5-coder:7b,mistral:7b,phi4-mini:3.8b,llama3.2:3b
